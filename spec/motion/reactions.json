{
  "version": 2,
  "description": "Réactions de la créature aux actions et aux gestes (D4, annexe A2). Séquences courtes jouées une fois, par-dessus l'état courant : elles ne remplacent ni les poses ni les boucles de poses.json. Elles visent des NOMS de parties communs aux deux espèces (poses/kawaii.json et poses/feerique.json), les groupes `targets` ajoutés ci-dessous et les cibles communes `groups` (head-tips, wings, chest-light : oreilles ou antennes, ailes, étoile de poitrine), jamais des fichiers ni des coordonnées d'écran : elles se transposent donc à un autre stade ou à une autre espèce. Format décrit dans spec/motion/README.md (section « reactions.json »).",
  "limits": { "minDuration": 600, "maxDuration": 1200 },
  "targets": {
    "touch": { "origin": [120, 204], "note": "Groupe enveloppant toute la créature (au-dessus de creature et pose) : mouvements d'ensemble des réactions et suivi du geste. Ne reçoit aucune boucle de poses.json." },
    "gaze": { "origin": [120, 132], "note": "Groupe qui enveloppe les deux yeux : regard (translation de quelques unités)." }
  },
  "groups": {
    "head-tips": {
      "mirror": true, "additive": true,
      "parts": { "kawaii": ["ear-left", "ear-right"], "feerique": ["antenna-left", "antenna-right"] },
      "note": "Extrémités de la tête : oreilles chez kawaii, antennes chez féérique. Images clés = écarts du côté DROIT (rotation positive = vers l'extérieur), le côté gauche est inversé. Ajoutées à la pose de l'état : des antennes tombantes ne sont pas redressées."
    },
    "wings": {
      "mirror": true, "additive": true,
      "parts": { "kawaii": ["wing-left", "wing-right"], "feerique": ["wing-left", "wing-right"] },
      "note": "Ailes : féérique dès le bébé, kawaii à l'âge adulte seulement (aux autres stades la cible est ignorée). Écarts du côté DROIT (rotation positive = l'aile s'ouvre), côté gauche inversé."
    },
    "chest-light": {
      "mirror": false, "additive": true,
      "parts": { "feerique": ["core"] },
      "note": "Étoile de poitrine : féérique seulement. Écarts (une échelle de 1,25 grossit l'étoile de 25 %)."
    },
    "tail-wag": {
      "mirror": false, "additive": true,
      "parts": { "kawaii": ["tail"], "feerique": ["tail"] },
      "note": "Queue : adolescent et adulte, dans les deux espèces (aux stades plus jeunes la cible est ignorée). Écarts de rotation autour de la racine de la queue, jamais de version éteinte redressée : la queue qui pend frétille depuis sa pose. Nom distinct de la partie `tail` : un groupe ne porte jamais un nom de partie."
    },
    "crown-glow": {
      "mirror": false, "additive": true,
      "parts": { "feerique": ["crown"] },
      "note": "Couronne de pétales : féérique adulte seulement. Écarts (une échelle de 1,1 grossit la couronne de 10 %), même rythme que l'étoile de poitrine."
    }
  },
  "props": {
    "bowl":        { "file": "props/bowl.svg",        "at": [172, 196], "size": 46, "note": "Bol du repas, posé en bas à droite, hors du visage." },
    "starfruit":   { "file": "props/starfruit.svg",   "at": [172, 184], "size": 28, "note": "Fruit étoilé du repas (dans le bol au départ)." },
