{
  "version": 1,
  "description": "Préréglages de particules (D4). Un seul canvas 2D en surimpression (web) ou un CustomPainter (Flutter). Longueurs et vitesses en unités du viewBox 240x240 de la créature, que le moteur met à l'échelle. Les couleurs sont des jetons de spec/theme.json.",
  "limits": {
    "maxParticles": 40,
    "note": "Plafond global, tous préréglages confondus. Quand il est atteint, les émissions de priorité plus basse sont retardées ou abandonnées (priority : plus grand = plus important)."
  },
  "pauseWhenHidden": true,
  "reducedMotion": "Aucune particule : le moteur ignore tous les préréglages quand le mouvement réduit est actif.",
  "avoidZones": [
    { "id": "face", "shape": "ellipse", "center": [120, 138], "radii": [52, 30], "rule": "Une particule qui entre dans la zone s'estompe à 0 : rien ne passe devant les yeux." }
  ],
  "shapes": {
    "orb": "Disque avec lueur en dégradé radial",
    "sparkle4": "Étincelle à quatre branches aux pointes arrondies",
    "bubble": "Anneau fin avec reflet, centre quasi transparent",
    "leaf": "Petite feuille en goutte allongée",
    "moon": "Petit croissant",
    "star": "Petite étoile à quatre branches, plus ronde"
  },
  "fields": {
    "mode": "continuous (émission répétée) ou burst (une seule bouffée)",
    "count": "burst : nombre de particules émises",
    "emitDuration": "burst : durée sur laquelle les naissances sont étalées (ms)",
    "maxAlive": "continuous : particules vivantes en même temps",
    "spawnEveryMs": "continuous : intervalle entre deux naissances [min, max]",
    "emitter": "point (center), ellipse (center, radii) ou line (from, to)",
    "life": "durée de vie [min, max] en ms",
    "speed": "[min, max] en unités par seconde",
    "angle": "[min, max] en degrés, 0 = vers la droite, -90 = vers le haut",
    "gravity": "unités par seconde², positif = vers le bas",
    "wander": "oscillation latérale : amplitude (unités) et période [min, max] ms",
    "spin": "rotation [min, max] en degrés par seconde",
    "scaleOverLife": "[début, fin] multiplicateur de la taille",
    "fade": "in et out : fractions de la vie passées à apparaître et à disparaître",
    "motion": "free (par défaut), spiral (autour de center, rayon qui décroît) ou converge (vers target)",
    "glow": "lueur peinte en dégradé radial : radius (multiple de la taille) et opacity",
    "priority": "ordre de priorité face au plafond global",
    "spiral": "motion spiral : center, radiusFrom, radiusTo, turns, rise (décalage vertical total)",
    "avoidFace": "false pour ignorer la zone face (ex. Envol, où le visage a disparu)"
  },
  "presets": {
    "ambient": {
      "label": "Lucioles d'ambiance",
      "mode": "continuous", "maxAlive": 7, "spawnEveryMs": [1100, 2200], "priority": 1,
      "emitter": { "shape": "ellipse", "center": [120, 120], "radii": [150, 100] },
      "shape": "orb", "colors": ["firefly-gold", "moonmilk-cream"],
      "size": [2.4, 4.6], "life": [8000, 13000],
      "speed": [4, 9], "angle": [-120, -60], "gravity": 0,
      "wander": { "amplitude": 12, "period": [3200, 5200] },
      "fade": { "in": 0.3, "out": 0.35 }, "scaleOverLife": [0.8, 1],
      "glow": { "radius": 3.2, "opacity": 0.55 }
    },
    "feed": {
      "label": "Nourrir : étincelles dorées",
      "mode": "burst", "count": 14, "emitDuration": 500, "priority": 3,
      "emitter": { "shape": "ellipse", "center": [120, 172], "radii": [34, 12] },
      "shape": "sparkle4", "colors": ["firefly-gold", "moonmilk-cream"],
      "size": [4, 8], "life": [900, 1500],
      "speed": [18, 42], "angle": [-140, -40], "gravity": -6,
      "wander": { "amplitude": 4, "period": [1200, 1800] },
      "spin": [-40, 40],
      "fade": { "in": 0.12, "out": 0.5 }, "scaleOverLife": [0.6, 1],
      "glow": { "radius": 2.4, "opacity": 0.5 }
    },
    "wash": {
