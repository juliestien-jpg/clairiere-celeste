      "emitter": { "shape": "ellipse", "center": [120, 150], "radii": [60, 40] },
      "shape": "bubble", "colors": ["moon-blue", "dawn-pink", "fairy-mint", "moonmilk-cream"],
      "size": [5, 11], "life": [1400, 2200],
      "speed": [14, 30], "angle": [-120, -60], "gravity": -4,
      "wander": { "amplitude": 8, "period": [1400, 2200] },
      "fade": { "in": 0.15, "out": 0.4 }, "scaleOverLife": [0.7, 1.1],
